# Required for OpenAI embeddings and OpenAI chat.
OPENAI_API_KEY=
# Optional; required when using Anthropic chat.
ANTHROPIC_API_KEY=

# Local Postgres development defaults for docker-compose.yml.
# Keep these values and POSTGRES_CONNECTIONSTRING in sync if you change them.
POSTGRES_USER=fieldguide
POSTGRES_PASSWORD=fieldguide
POSTGRES_DB=fieldguide
POSTGRES_PORT=5432
# Consumed by vectorstore-ai's catalog; Fieldguide wiring comes in later phases.
POSTGRES_CONNECTIONSTRING=postgresql://fieldguide:fieldguide@localhost:5432/fieldguide
